{
  "name": "whisper-dataset-builder",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @whisper-dataset-builder/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @whisper-dataset-builder/web build",
    "typecheck": "pnpm --filter @whisper-dataset-builder/web typecheck",
    "lint": "pnpm --filter @whisper-dataset-builder/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "build:dataset": "cd services/api && .venv/bin/python scripts/build_dataset.py",
    "test:e2e": "pnpm --filter @whisper-dataset-builder/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": ">=7.29.6 <8",
      "@hono/node-server": ">=1.19.15",
      "ajv@6.12.6": "npm:ajv@6.14.0",
      "ajv@8.17.1": "npm:ajv@8.18.0",
      "body-parser": ">=2.3.0",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=2.0.0 <2.1.3": ">=2.1.3",
      "express-rate-limit": ">=8.2.2",
      "fast-uri": ">=3.1.5",
      "flatted": ">=3.4.2",
      "hono": ">=4.12.34",
      "ip-address": ">=10.3.1",
      "js-yaml": ">=4.3.1",
      "lodash": ">=4.18.0",
      "minimatch@10.1.2": "npm:minimatch@10.2.6",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "path-to-regexp": ">=8.4.0",
      "picomatch@4.0.3": "npm:picomatch@4.0.5",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss": ">=8.5.23",
      "qs": ">=6.15.2",
      "sharp": ">=0.35.0",
      "shell-quote": ">=1.9.0"
    }
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
