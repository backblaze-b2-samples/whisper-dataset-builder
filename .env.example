# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region drives the S3 endpoint (https://s3.{B2_REGION}.backblazeb2.com).
B2_REGION=us-west-004
# Public base URL for objects (optional — used to build shareable links).
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001-EXAMPLE-not-a-real-key-xxxxxxxx
# B2_BUCKET_NAME=my-speech-datasets
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-speech-datasets.s3.us-west-004.backblazeb2.com

# --- Dataset builder pipeline (local OSS — no remote inference API) ---
# FREE HuggingFace token, used ONLY to download pyannote's gated
# segmentation-3.0 weights (https://huggingface.co/settings/tokens). Accept
# the model terms once at https://huggingface.co/pyannote/segmentation-3.0.
# Leave empty to run with the built-in token-free energy VAD fallback so the
# app works end-to-end with B2 credentials alone. Never billed, never an
# inference API.
HF_TOKEN=

# On-B2 layout prefixes.
SOURCE_PREFIX=sources/
DATASET_PREFIX=datasets/

# Local ML engine knobs (CPU-friendly defaults; device is auto-detected
# CUDA -> MPS -> CPU at runtime — set DEVICE=cpu|cuda|mps to force one).
WHISPER_MODEL=base
DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
# VAD engine: auto (pyannote if HF_TOKEN set, else energy) | pyannote | energy
VAD_ENGINE=auto
SEGMENTATION_MODEL=pyannote/segmentation-3.0

# Default clip quality / shape filters (overridable per dataset build).
MIN_CLIP_SEC=1.0
MAX_CLIP_SEC=20.0
MIN_SNR_DB=10.0
TARGET_SAMPLE_RATE=16000
